# Frontend
VITE_EMERGENCY_NUMBER=112
# Server (docs/architecture.md §9)
PORT=3000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key   # server only — never commit the real value
# Local AI + speech run inside the server; models download into models/ with `npm run setup-ai` (server laptop only).
# Optional overrides (defaults shown):
# AI_MODEL=hf:Qwen/Qwen2.5-3B-Instruct-GGUF:Q4_K_M
# WHISPER_MODEL=./models/ggml-small.bin
# true only while developing on this laptop (enables the demo reset); false when the server is reachable from outside.
DEV_MODE=true
EMERGENCY_NUMBER=112

# Public address of this laptop through ngrok (`npm run tunnel:ngrok`). Phones, the Android app and Vercel use it.
# Your free static domain from the ngrok dashboard → Domains, with https://.
PUBLIC_SERVER_URL=https://your-domain.ngrok-free.dev
# ngrok login token (ngrok dashboard → Your Authtoken). Leave empty if you ran `ngrok config add-authtoken` once.
NGROK_AUTHTOKEN=
